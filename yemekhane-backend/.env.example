# --------------------------------------------------
# YEMEKHANE BACKEND ÖRNEK ORTAM AYARLARI
#
# Bu dosya gerçek parola içermez ve GitHub'a gönderilir.
# Projeyi kuran kişi bunu .env adıyla kopyalar.
# --------------------------------------------------

DB_URL=jdbc:mysql://127.0.0.1:3306/yemekhane_db
DB_USERNAME=yemekhane_app
DB_PASSWORD=CHANGE_ME_LOCAL_PASSWORD

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_FULL_NAME=CHANGE_ME
BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_WITH_A_BASE64_SECRET
JWT_ISSUER=yemekhane-backend
JWT_EXPIRATION_SECONDS=3600